# Arc RPC (fill in once you have testnet/mainnet endpoints + faucet funds)
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=

# Deployer key — testnet only, never commit a real key. Used for the
# one-time proxy deploy; does not need to be PROTOCOL_ADMIN.
DEPLOYER_PRIVATE_KEY=

# First deploy (DeployProgramVault.s.sol) — one time, ever, per network.
# All merchant onboarding after this happens via createProgram(), not a
# redeploy.
USDC_ADDRESS=      # stablecoin every program is denominated in (immutable per implementation)
PROTOCOL_ADMIN=    # Reserva-side key authorized to upgrade the contract later — not a merchant

# Upgrades only (UpgradeProgramVault.s.sol) — must broadcast from
# PROTOCOL_ADMIN's key.
PROGRAM_VAULT_PROXY=       # the deployed proxy address to upgrade
PROTOCOL_ADMIN_PRIVATE_KEY=
